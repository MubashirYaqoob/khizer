generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PAID
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(CUSTOMER)
  address   String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
  volumes     Volume[]
}

model Volume {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  products     Product[]
}

model Product {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String
  price        Float
  salePrice    Float?
  images       String[]
  sizes        String[]
  sizeChartUrl String?
  details      Json?
  stock        Int           @default(0)  // total stock cache (sum of all sizeStocks)
  isFeatured   Boolean       @default(false)
  isActive     Boolean       @default(true)
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  volumeId     String?
  volume       Volume?       @relation(fields: [volumeId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orderItems   OrderItem[]
  sizeStocks   ProductSize[]
  reviews      Review[]
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int     @default(0)

  @@unique([productId, size])
}

model Order {
  id              String           @id @default(cuid())
  userId          String?
  user            User?            @relation(fields: [userId], references: [id])
  guestName       String?
  guestEmail      String?
  status          OrderStatus      @default(PENDING)
  totalAmount     Float
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus    @default(UNPAID)
  deliveryAddress String
  city            String
  phone           String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderItems      OrderItem[]
  customizedOrder CustomizedOrder?
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?  // Snapshot of product name at time of order
  quantity    Int
  price       Float
  size        String?
}

model CustomizedOrder {
  id                  String   @id @default(cuid())
  orderId             String   @unique
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  chest               Float
  waist               Float
  hips                Float
  length              Float
  sleeves             Float
  fabricChoice        String
  specialInstructions String?
  estimatedDays       Int      @default(14)
}

model HeroBanner {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String
  subtitle  String?
  ctaText   String?
  ctaLink   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  email     String
  rating    Int      // 1 to 5 stars
  comment   String
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
