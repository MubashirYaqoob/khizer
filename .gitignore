# ===========================
# KFS - .gitignore
# ===========================

# Next.js build output
.next/
out/
build/

# Node dependencies
node_modules/

# Environment files (keep secrets out of repo)
.env
.env.local
.env*.local

# TypeScript build info
*.tsbuildinfo

# Next.js generated types
next-env.d.ts

# Yarn / PnP
.pnp
.pnp.js
.yarn/install-state.gz

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Vercel
.vercel

# Certificates
*.pem

# Coverage reports
coverage/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
